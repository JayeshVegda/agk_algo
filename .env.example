# AKG ALGO environment example.
# The stack is a single PocketBase binary + compiled React frontend in pb_public;
# there is no Node/Postgres layer anymore.

# Seed scripts (scripts/setup_pb.py, scripts/apply_hardening.py) read these.
# Never commit real values; copy this file to .env (gitignored) for local runs.
AKG_SUPERUSER_EMAIL=jayeshvegda@gmail.com
AKG_SUPERUSER_PASSWORD=            # strong secret; required by the scripts
AKG_ADMIN_PASSWORD=                # strong secret for the app admin account
AKG_DEMO_PASSWORD=                 # optional separate password for the demo member

# Public URL used when sharing links (used by seed content, not the server itself).
PUBLIC_URL=http://localhost:8095

# Server-side encryption key for managed-account broker passwords.
# REQUIRED in production: generate with `openssl rand -base64 32`.
# Changing it invalidates previously stored credentials.
AKG_CRED_KEY=change-me-long-random
