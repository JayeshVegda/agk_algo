# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
BUSINESS_TIMEZONE=UTC

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/akg_algo

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=change-me-long-random
BETTER_AUTH_URL=http://localhost:3000

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AKG ALGO <no-reply@example.com>"

# --- Encryption for connector credentials (32-byte key, base64) ---
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEY_VERSION=1

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
DOWNLOAD_URL_SIGNING_SECRET=change-me

# --- Feature flags ---
CONNECTOR_REAL_MODE=false
PAYMENTS_MANUAL_TXID_ENABLED=true
PAYMENTS_BTCPAY_ENABLED=false

# --- BTCPay Server (only when enabled) ---
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
