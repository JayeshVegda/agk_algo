{
  "name": "akg-algo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @akg/web dev",
    "dev:worker": "pnpm --filter @akg/worker dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "pnpm --recursive run test",
    "test:e2e": "pnpm --filter @akg/web test:e2e",
    "db:generate": "pnpm --filter @akg/db db:generate",
    "db:migrate": "pnpm --filter @akg/db db:migrate",
    "db:seed": "pnpm --filter @akg/db db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@11.3.0"
}
