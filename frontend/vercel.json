{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/bots",
      "destination": "/storefront/bots.html"
    },
    {
      "source": "/pricing",
      "destination": "/storefront/pricing.html"
    },
    {
      "source": "/signals",
      "destination": "/app.html"
    },
    {
      "source": "/bots/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/charts",
      "destination": "/app.html"
    },
    {
      "source": "/terminal-desk",
      "destination": "/app.html"
    },
    {
      "source": "/desk",
      "destination": "/app.html"
    },
    {
      "source": "/kit",
      "destination": "/app.html"
    },
    {
      "source": "/account",
      "destination": "/app.html"
    },
    {
      "source": "/checkout",
      "destination": "/app.html"
    },
    {
      "source": "/terms",
      "destination": "/app.html"
    },
    {
      "source": "/refund",
      "destination": "/app.html"
    },
    {
      "source": "/risk",
      "destination": "/app.html"
    },
    {
      "source": "/privacy",
      "destination": "/app.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:file([A-Za-z0-9._-]+-[A-Za-z0-9_-]{8}\\.(?:js|css))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/logos/akg-algo-crest-96.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/logos/akg-algo-crest-384.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/assets/brand/robot-store.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
